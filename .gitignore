# Flutter / Dart
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/pubspec.lock

# Платформенные папки генерируются в CI (flutter create), в репо не храним
app/android/
app/ios/
app/web/
app/linux/
app/macos/
app/windows/
app/.metadata

# Ассеты приложения детерминированно выводятся из data/ — генерируются шагом
# сборки, а не коммитятся: иначе каждая перегонка корпуса кладёт в историю
# новый блоб на 8.6 МБ.
app/assets/*.json

# IDE / OS
*.iml
.idea/
.vscode/
.DS_Store

# Python (контент-пайплайн в scripts/)
__pycache__/
*.pyc
